// Pocket: wishes, funds, loans. Entered by hand, stored in your own database.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String  @id @default(cuid())
  email      String  @unique
  name       String?
  image      String?
  provider   String
  providerId String

  createdAt   DateTime @default(now())
  lastLoginAt DateTime @updatedAt

  sections WishSection[]
  wishes   Wish[]
  funds    Fund[]
  loans    Loan[]

  @@index([email])
}

/** A group of wishes: Mom, Dad, Sisters, Me, Home... */
model WishSection {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name  String
  emoji String?
  order Int    @default(0)

  createdAt DateTime @default(now())

  wishes Wish[]

  @@index([userId, order])
}

model Wish {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sectionId String
  section   WishSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  name   String
  amount Int      @default(0) // expected ₹
  links  String[] @default([])
  note   String?
  done   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
}

/** Money set aside for something: a target and what's in it right now. */
model Fund {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name    String
  emoji   String?
  target  Int     @default(0) // ₹
  balance Int     @default(0) // ₹, kept in step with entries
  note    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries FundEntry[]

  @@index([userId])
}

model FundEntry {
  id     String @id @default(cuid())
  fundId String
  fund   Fund   @relation(fields: [fundId], references: [id], onDelete: Cascade)

  amount Int      // ₹, positive = put in, negative = took out
  note   String?
  date   DateTime @default(now())

  @@index([fundId, date])
}

enum LoanDirection {
  LENT     // they owe me
  BORROWED // I owe them
}

model Loan {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  direction LoanDirection @default(BORROWED)
  amount    Int           // ₹ total
  endDate   DateTime?
  note      String?
  closed    Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments LoanPayment[]

  @@index([userId])
}

model LoanPayment {
  id     String @id @default(cuid())
  loanId String
  loan   Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)

  amount Int      // ₹ paid
  note   String?
  date   DateTime @default(now())

  @@index([loanId, date])
}
